# Copy this file to .env and fill in what you need. .env is git-ignored: never commit it, never paste keys into chat.
#
# REQUIRED to chat with the agent (UI chat, `python -m quaketriage.agent`, evaluation): ONE LLM key, free tier is enough.
#   Option 1 (default): Gemini key from https://aistudio.google.com/apikey  (set GEMINI_API_KEY)
#   Option 2: Groq key from https://console.groq.com  (set GROQ_API_KEY, LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-120b)
# NOT needed for: downloads, tests, building the demo set, planning scripts, the UI map/tables without chat.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# OPTIONAL fallback when the primary provider stays rate-limited (HTTP 429). Needs the matching key above.
# Leave LLM_FALLBACK_MODEL empty to disable the fallback.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# OPTIONAL: only for model training (Path 2): Hugging Face token (download KATE-CD) and Kaggle credentials (GPU notebooks).
HF_TOKEN=your_huggingface_token_here
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# OPTIONAL: use another config file instead of configs/default.yaml
# QUAKETRIAGE_CONFIG=configs/default.yaml
